<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MiMascota.Views.RecuperarPassPage"
             Title="Recuperar Contraseña"
             BackgroundColor="#F5F7FA">

    <Grid RowDefinitions="*, Auto, *">
        <VerticalStackLayout Grid.Row="1"
                             Spacing="20"
                             Padding="30"
                             BackgroundColor="White"
                             Margin="20"
                             VerticalOptions="Center"
                             HorizontalOptions="Center"
                             WidthRequest="340"
                             >

            <Image Source="mail_icon.png"
                   HeightRequest="60"
                   WidthRequest="60"
                   HorizontalOptions="Center" />

            <Label Text="Recuperar Contraseña"
                   FontSize="22"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="#1976D2" />

            <Label Text="Ingresa tu correo electrónico registrado. Te enviaremos instrucciones para restablecer tu contraseña."
                   FontSize="14"
                   TextColor="Gray"
                   HorizontalTextAlignment="Center" />

            <Entry x:Name="EmailEntry"
                   Placeholder="Correo Electrónico"
                   Keyboard="Email"
                   TextColor="Black"
                   PlaceholderColor="Gray"
                   BackgroundColor="#F0F0F0"
                   HeightRequest="45"
                    />

            <Button Text="Enviar Instrucciones"
                    Clicked="OnSendClicked"
                    BackgroundColor="#1976D2"
                    TextColor="White"
                    CornerRadius="10"
                    HeightRequest="50"
                    FontAttributes="Bold" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
