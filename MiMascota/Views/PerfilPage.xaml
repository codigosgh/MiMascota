<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MiMascota.Views.PerfilPage"
    Title="Perfil"
    BackgroundColor="White">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Agent Profile Header -->
            <HorizontalStackLayout Spacing="15" VerticalOptions="Center">
                <Frame
                    WidthRequest="60"
                    HeightRequest="60"
                    CornerRadius="30"
                    HasShadow="False"
                    Padding="0">
                    <Image
                        Source="robin.jpg"
                        Aspect="AspectFill" />
                </Frame>

                <VerticalStackLayout VerticalOptions="Center" Spacing="2">
                    <Label
                        Text="Robin Aleson"
                        FontSize="20"
                        FontAttributes="Bold"
                        TextColor="Black" />
                    <Label
                        Text="robin.aleson@mauikit.com"
                        FontSize="14"
                        TextColor="#666666" />
                </VerticalStackLayout>

                <Button
                    Text="Edit"
                    BackgroundColor="#007AFF"
                    TextColor="White"
                    CornerRadius="8"
                    Padding="8,4"
                    HorizontalOptions="EndAndExpand" />
            </HorizontalStackLayout>

            <!-- Acción rápida: Favorito / Chat / Llamada -->
            <HorizontalStackLayout
                Spacing="30"
                HorizontalOptions="Center"
                Padding="0,10">
                <!-- Corazón -->
                <Label
                    FontFamily="FontAwesomeSolid"
                    Text="&#xf004;"
                    FontSize="24"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleFavoriteCommand}" />
                    </Label.GestureRecognizers>
                </Label>

                <!-- Chat -->
                <Label
                    FontFamily="FontAwesomeSolid"
                    Text="&#xf4ad;"
                    FontSize="24"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenChatCommand}" />
                    </Label.GestureRecognizers>
                </Label>

                <!-- Teléfono -->
                <Label
                    FontFamily="FontAwesomeSolid"
                    Text="&#xf095;"
                    FontSize="24"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding CallCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>

            <!-- Popular Section -->
            <Label
                Text="Popular"
                FontSize="18"
                FontAttributes="Bold"
                TextColor="#333333" />

            <CollectionView
                ItemsLayout="HorizontalList"
                HeightRequest="200"
                ItemsSource="{Binding PopularItems}"
                HorizontalScrollBarVisibility="Never">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame
                            WidthRequest="140"
                            Margin="0,0,15,0"
                            CornerRadius="12"
                            HasShadow="False"
                            BackgroundColor="#FFFFFF">
                            <Grid>
                                <Image
                                    Source="{Binding ImageUrl}"
                                    Aspect="AspectFill"
                                    HeightRequest="100"
                                    WidthRequest="140"
                                    
                                    VerticalOptions="Start" />

                                <!-- Corazón superpuesto (favorito) -->
                                <Label
                                    FontFamily="FontAwesomeSolid"
                                    Text="&#xf004;"
                                    FontSize="16"
                                    TextColor="{Binding IsFavorite, Converter={StaticResource BoolToColorConverter}, ConverterParameter='True=Red;False=White'}"
                                    BackgroundColor="Transparent"
                                    HorizontalOptions="End"
                                    VerticalOptions="Start"
                                    Margin="8">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ToggleFavoriteCommand}" />
                                    </Label.GestureRecognizers>
                                </Label>

                                <VerticalStackLayout Padding="8" Spacing="4" VerticalOptions="End">
                                    <Label
                                        Text="{Binding Title}"
                                        FontSize="14"
                                        FontAttributes="Bold"
                                        LineBreakMode="TailTruncation" />

                                    <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                        <Label
                                            Text="{Binding Price}"
                                            FontSize="14"
                                            TextColor="#007AFF"
                                            FontAttributes="Bold" />
                                        <Label
                                            Text="/mo"
                                            FontSize="12"
                                            TextColor="#666666" />
                                    </HorizontalStackLayout>

                                    <HorizontalStackLayout Spacing="2" VerticalOptions="Center">
                                        <!-- Estrella de rating -->
                                        <Label
                                            FontFamily="FontAwesomeSolid"
                                            Text="&#xf005;"
                                            FontSize="12"
                                            TextColor="#FFC107" />
                                        <Label
                                            Text="{Binding Rating}"
                                            FontSize="12"
                                            TextColor="#666666" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- My Favorite Section -->
            <Label
                Text="My Favorite"
                FontSize="18"
                FontAttributes="Bold"
                TextColor="#333333"
                Margin="0,20,0,0" />

            <CollectionView
                ItemsLayout="HorizontalList"
                HeightRequest="200"
                ItemsSource="{Binding FavoriteItems}"
                HorizontalScrollBarVisibility="Never">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame
                            WidthRequest="140"
                            Margin="0,0,15,0"
                            CornerRadius="12"
                            HasShadow="False"
                            BackgroundColor="#FFFFFF">
                            <Grid>
                                <Image
                                    Source="{Binding ImageUrl}"
                                    Aspect="AspectFill"
                                    HeightRequest="100"
                                    WidthRequest="140"
                                    VerticalOptions="Start" />

                                <Label
                                    FontFamily="FontAwesomeSolid"
                                    Text="&#xf004;"
                                    FontSize="16"
                                    TextColor="Red"
                                    BackgroundColor="Transparent"
                                    HorizontalOptions="End"
                                    VerticalOptions="Start"
                                    Margin="8" />

                                <VerticalStackLayout Padding="8" Spacing="4" VerticalOptions="End">
                                    <Label
                                        Text="{Binding Title}"
                                        FontSize="14"
                                        FontAttributes="Bold"
                                        LineBreakMode="TailTruncation" />

                                    <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                        <Label
                                            Text="{Binding Price}"
                                            FontSize="14"
                                            TextColor="#007AFF"
                                            FontAttributes="Bold" />
                                        <Label
                                            Text="/mo"
                                            FontSize="12"
                                            TextColor="#666666" />
                                    </HorizontalStackLayout>

                                    <HorizontalStackLayout Spacing="2" VerticalOptions="Center">
                                        <Label
                                            FontFamily="FontAwesomeSolid"
                                            Text="&#xf005;"
                                            FontSize="12"
                                            TextColor="#FFC107" />
                                        <Label
                                            Text="{Binding Rating}"
                                            FontSize="12"
                                            TextColor="#666666" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
